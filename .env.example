# ---- Shared ----
NODE_ENV=development

# ---- API ----
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://wi:wi_dev_password@localhost:5434/website_intelligence
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Audit submissions per IP per window (starting an audit is the expensive operation)
AUDIT_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_MAX=5
# Reverse-proxy hops in front of the API (rate limiting uses the real client IP). Verify per host: docs/deployment.md
TRUST_PROXY_HOPS=1

# ---- Worker ----
WORKER_CONCURRENCY=2
# Google PageSpeed Insights API key. Required for the performance analyzer;
# without it the performance category is reported as unavailable (never faked).
PAGESPEED_API_KEY=
# Per-analyzer time budget (not per audit)
AUDIT_TIMEOUT_MS=120000
# Keep Chromium's sandbox on. Set true ONLY in a locked-down container that cannot grant it.
BROWSER_NO_SANDBOX=false
MAX_RESPONSE_BYTES=5242880

# ---- Web (Vite) ----
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ---- Docker Compose database ----
POSTGRES_USER=wi
POSTGRES_PASSWORD=wi_dev_password
POSTGRES_DB=website_intelligence

# Host port for the compose Postgres (container always uses 5432)
POSTGRES_PORT=5434
